import numpy as np\
import plotly.graph_objects as go\
\
# Funktion: Torus erstellen\
def generate_torus(R=1, r=0.3, resolution=100):\
    u = np.linspace(0, 2 * np.pi, resolution)\
    v = np.linspace(0, 2 * np.pi, resolution)\
    u, v = np.meshgrid(u, v)\
    \
    # Torus-Koordinaten berechnen\
    x = (R + r * np.cos(v)) * np.cos(u)\
    y = (R + r * np.cos(v)) * np.sin(u)\
    z = r * np.sin(v)\
    return x, y, z\
\
# Daten generieren\
x, y, z = generate_torus()\
\
# Plotly-Oberfl\'e4che f\'fcr 3D-Darstellung\
fig = go.Figure(data=[go.Surface(x=x, y=y, z=z, colorscale='Viridis')])\
\
# Visualisierung anpassen\
fig.update_layout(\
    title="3D Torus (Einheit & Unendlichkeit)",\
    scene=dict(\
        xaxis_title="X-Achse",\
        yaxis_title="Y-Achse",\
        zaxis_title="Z-Achse",\
    ),\
)\
\
# Plot anzeigen\
